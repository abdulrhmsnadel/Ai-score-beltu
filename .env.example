# AI providers (never commit real values)
BELTU_OPENAI_API_KEY=
BELTU_ANTHROPIC_API_KEY=
BELTU_ANTHROPIC_MODEL=claude-sonnet-4-6
BELTU_DEEPSEEK_API_KEY=
BELTU_DEEPSEEK_BASE_URL=https://api.deepseek.com
# DeepSeek-Coder-V2 compatibility endpoint/model. Current public DeepSeek API exposes V4 models.
BELTU_DEEPSEEK_MODEL=deepseek-coder-v2

# Local Code Llama / Ollama
BELTU_CODELLAMA_ENABLED=0
BELTU_CODELLAMA_MODEL=codellama:13b
BELTU_OLLAMA_URL=http://127.0.0.1:11434

# PentestGPT planner-only adapter
BELTU_PENTESTGPT_BIN=pentestgpt

# Interactsh official client adapter
BELTU_INTERACTSH_BIN=interactsh-client

# Optional AI automation
BELTU_AI_AUTORUN=0
